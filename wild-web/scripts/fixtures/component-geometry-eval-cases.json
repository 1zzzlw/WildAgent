{
  "version": 1,
  "validCases": [
    {
      "id": "door_on_front_wall",
      "component": {
        "type": "door",
        "id": "eval_door",
        "parentWall": "front_wall",
        "from": [1, 0, 0],
        "width": 1,
        "height": 2.2
      },
      "expectedGeneratedCount": 4,
      "expectedTypes": ["opening", "primitive", "primitive", "primitive"]
    },
    {
      "id": "window_on_side_wall_with_mullions",
      "component": {
        "type": "window",
        "id": "eval_window",
        "parentWall": "side_wall",
        "from": [1, 0.9, 0],
        "width": 1.8,
        "height": 1.2,
        "verticalMullions": 2,
        "horizontalMullions": 1
      },
      "expectedGeneratedCount": 8,
      "expectedTypes": ["opening", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive"]
    },
    {
      "id": "sloped_railing_path",
      "component": {
        "type": "railing",
        "id": "eval_railing",
        "path": [[0, 0, 2], [2, 1, 2]],
        "height": 1.1,
        "postSpacing": 0.8,
        "railLevels": [0.5, 1]
      },
      "expectedGeneratedCount": 6,
      "expectedTypes": ["primitive", "primitive", "primitive", "primitive", "beam", "beam"]
    },
    {
      "id": "wall_canopy",
      "component": {
        "type": "canopy", "id": "eval_canopy", "parentWall": "front_wall",
        "from": [0.5, 2.5, 0], "width": 2, "depth": 1, "thickness": 0.12
      },
      "expectedGeneratedCount": 1,
      "expectedTypes": ["primitive"]
    },
    {
      "id": "wall_balcony",
      "component": {
        "type": "balcony", "id": "eval_balcony", "parentWall": "front_wall",
        "from": [3, 1.2, 0], "width": 2.4, "depth": 1.2, "slabThickness": 0.18,
        "postSpacing": 0.9
      },
      "expectedGeneratedCount": 15,
      "expectedTypes": [
        "primitive", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive",
        "beam", "beam", "beam", "beam", "beam", "beam"
      ]
    },
    {
      "id": "ramp_with_both_railings",
      "component": {
        "type": "ramp", "id": "eval_ramp", "from": [0, 0, 5], "to": [3, 0.45, 5],
        "width": 1.2, "thickness": 0.18, "railingSides": "both"
      },
      "expectedGeneratedCount": 17,
      "expectedTypes": [
        "primitive", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive",
        "beam", "beam", "primitive", "primitive", "primitive", "primitive", "primitive", "primitive",
        "beam", "beam"
      ]
    },
    {
      "id": "projected_bay_window",
      "component": {
        "type": "bay_window", "id": "eval_bay_window", "parentWall": "side_wall",
        "from": [1.2, 0.9, 0], "width": 1.8, "height": 1.2, "projectionDepth": 0.45
      },
      "expectedGeneratedCount": 10,
      "expectedTypes": [
        "opening", "primitive", "primitive", "primitive", "primitive",
        "primitive", "primitive", "primitive", "primitive", "primitive"
      ]
    },
    {
      "id": "profile_sweep_cornice",
      "component": {
        "type": "cornice", "id": "eval_cornice", "path": [[0, 3, 0], [4, 3, 0]],
        "profile": [[-0.08, -0.08], [0.08, -0.08], [0.08, 0.08], [-0.08, 0.08]]
      },
      "expectedGeneratedCount": 1,
      "expectedTypes": ["primitive"]
    },
    {
      "id": "hollow_chimney",
      "component": {
        "type": "chimney", "id": "eval_chimney", "position": [6, 0, 4],
        "width": 0.7, "depth": 0.7, "height": 2
      },
      "expectedGeneratedCount": 5,
      "expectedTypes": ["primitive", "primitive", "primitive", "primitive", "primitive"]
    }
  ],
  "invalidCases": [
    {
      "id": "door_missing_parent_wall",
      "component": {
        "type": "door",
        "id": "eval_missing_wall",
        "parentWall": "missing_wall",
        "from": [0, 0, 0],
        "width": 0.9,
        "height": 2.1
      },
      "expectedError": "missing_wall"
    },
    {
      "id": "window_outside_parent_wall",
      "component": {
        "type": "window",
        "id": "eval_overflow_window",
        "parentWall": "front_wall",
        "from": [7.5, 0.9, 0],
        "width": 1.5,
        "height": 1.2
      },
      "expectedError": "超出父墙水平范围"
    },
    {
      "id": "railing_duplicate_path_points",
      "component": {
        "type": "railing",
        "id": "eval_broken_railing",
        "path": [[0, 0, 0], [0, 0, 0]],
        "height": 1.1
      },
      "expectedError": "不能重合"
    }
  ]
}
