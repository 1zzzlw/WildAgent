# Chat Model：负责理解用户请求，并结合 RAG 召回内容生成结果
CHAT__NAME=qwen3.8-max-0902
CHAT__API_KEY=replace-with-your-rotated-api-key
CHAT__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Agent 统一思考控制值；支持预算的模型使用 Token 上限，其他已知模型映射为推理档位。
# 0 表示使用供应商默认值；未知 OpenAI-compatible 服务不会被盲目注入非标准字段。
CHAT__THINKING_BUDGET=4096

# Embedding Model：负责知识库向量化和语义检索，不能替换为 Chat Model
EMBEDDING__NAME=text-embedding-v4
EMBEDDING__API_KEY=replace-with-your-rotated-api-key
EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单批向量请求超时（秒）。默认 60：代理/冷连接的首请求稍慢也能容忍；
# 索引同步在后台线程执行，超时只影响同步进度，不影响服务启动。
# 请求等待期间每 20s 输出一条心跳日志（SDK 内部重试已禁用，仅手动重试）。
# EMBEDDING__TIMEOUT=60
# 向量请求网络错误的手动重试次数（默认 1，指数退避）
# EMBEDDING__MAX_RETRIES=1

# Rerank Model：当前代码尚未接入，以下字段仅预留
RERANK__NAME=
RERANK__API_KEY=
RERANK__BASE_URL=

# RAG 检索与文档分块
RAG__ENABLED=true
RAG__PERSIST_DIR=storage/chroma
# 切换 Embedding 模型时请使用新的 collection 名，验证通过后再切换；
# 不要让新模型直接覆盖旧模型集合，否则失败时无法快速回滚。
RAG__COLLECTION_NAME=wild_knowledge_base
RAG__TOP_K=6
RAG__CHUNK_SIZE=900
RAG__CHUNK_OVERLAP=150
RAG__MAX_CONTEXT_CHARS=18000
# 服务启动后是否自动在后台线程增量同步索引（不阻塞启动）。
# 索引就绪前检索自动降级为基础规范上下文；关闭后需手动触发同步。
RAG__AUTO_SYNC=true

# 生产环境建议关闭；true 仅适合无 Embedding API 时的本地 smoke test
RAG__ALLOW_HASH_FALLBACK=false

# 可选 Presence 扩展：设为 false 时后端不统计，前端也不显示入口
PRESENCE__ENABLED=true
# 可选地区库；文件不存在时在线人数、脱敏 IP 和连接时间仍然可用
PRESENCE__GEOIP_DB=storage/geoip/GeoLite2-City.mmdb
PRESENCE__TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# 蓝图文件存储目录
# 默认：<server_root>/storage/scenes（本地）或 /app/storage/scenes（容器）
# 容器部署时该目录通过 -v $DEPLOY_DATA_DIR/scenes:/app/storage/scenes 挂载到宿主机
# 如需自定义路径（如 NFS 挂载或不同磁盘），在此设置绝对路径
# WILD_SCENES_DIR=/opt/wild-agent/storage/scenes
