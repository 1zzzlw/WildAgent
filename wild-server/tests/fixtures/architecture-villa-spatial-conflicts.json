  "design_intent": {
    "goals": [
      "两层独立住宅，功能分区明确",
      "南向前立面充分采光，客厅和餐厅使用大面玻璃",
      "简洁双坡屋顶，檐口适当出挑遮阳",
      "楼梯位于建筑中部偏后，高效连接各层"
    ],
    "assumptions": [
      "建筑坐北朝南，正面为南面",
      "一层为公共活动区，二层为私密休息区",
      "采用砖混或框架结构体系"
    ],
    "spatial_strategy": "一层前部为门厅与客厅（南向大窗），后部为餐厅厨房（北向采光）和多功能房；二层沿走廊布置主卧、两间次卧和卫生间，楼梯居中偏东",
    "composition": "对称前立面，中央入口突出雨棚形成视觉焦点；屋顶双坡简洁，山墙两侧各三bay开窗",
    "material_strategy": "主体白色弹性涂料，门窗框深灰色铝合金，屋面深灰色沥青瓦，入口雨棚清水混凝土",
    "selected_systems": [
      "双坡屋顶 gable",
      "矩形单层围护体量",
      "前混凝土雨棚",
      "钢木楼梯直跑加平台"
    ]
  },
  "materials": {
    "regions": []
  }
