{
  "version": 1,
  "description": "组合构件知识库固定检索评测；使用项目真实 MarkdownChunker、metadata 过滤与 Chroma 查询。",
  "cases": [
    {
      "id": "supported_static_door",
      "query": "基础静态门 door geometry.components parentWall frameWidth leafMaterial",
      "metadataFilter": {"doc_type": "component", "entity_type": "door"},
      "expectedSources": ["doors-supported.md"],
      "requiredTerms": ["geometry.components", "parentWall", "leafMaterial"]
    },
    {
      "id": "supported_static_window",
      "query": "基础静态窗 window geometry.components parentWall verticalMullions glassMaterial",
      "metadataFilter": {"doc_type": "component", "entity_type": "window"},
      "expectedSources": ["windows-supported.md"],
      "requiredTerms": ["geometry.components", "verticalMullions", "glassMaterial"]
    },
    {
      "id": "supported_path_railing",
      "query": "路径栏杆 railing geometry.components path postSpacing railLevels",
      "metadataFilter": {"doc_type": "component", "entity_type": "railing"},
      "expectedSources": ["railings.md"],
      "requiredTerms": ["geometry.components", "postSpacing", "railLevels"]
    },
    {
      "id": "component_engine_boundary",
      "query": "door window railing 当前支持 geometry.components 不能写入 geometry.elements",
      "metadataFilter": {"doc_type": "component", "entity_type": "component"},
      "expectedSources": ["engine-capability-boundaries.md"],
      "requiredTerms": ["door", "window", "railing"]
    },
    {
      "id": "building_component_recipe",
      "query": "建筑组装 门 窗 栏杆 geometry.components opening assembly",
      "metadataFilter": {"doc_type": "recipe", "entity_type": "assembly"},
      "expectedSources": ["assembly-templates.md", "component-building-matrix.md"],
      "requiredTerms": ["geometry.components", "railing"]
    },
    {
      "id": "supported_canopy",
      "query": "墙体雨棚 canopy parentWall depth supportCount 组合构件",
      "metadataFilter": {"doc_type": "component", "entity_type": "canopy"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["canopy", "parentWall", "supportCount"]
    },
    {
      "id": "supported_balcony",
      "query": "阳台 balcony slabThickness railingHeight 悬挑板",
      "metadataFilter": {"doc_type": "component", "entity_type": "balcony"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["balcony", "slabThickness", "railingHeight"]
    },
    {
      "id": "supported_ramp",
      "query": "坡道 ramp 连续斜面 侧缘挡台 随坡栏杆 railingSides parentFloor",
      "metadataFilter": {"doc_type": "component", "entity_type": "ramp"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["ramp", "railingSides", "parentFloor", "profile_sweep", "侧缘挡台"]
    },
    {
      "id": "supported_bay_window",
      "query": "凸窗 飘窗 bay_window projectionDepth parentWall",
      "metadataFilter": {"doc_type": "component", "entity_type": "bay_window"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["bay_window", "projectionDepth", "parentWall"]
    },
    {
      "id": "supported_cornice",
      "query": "建筑檐口 cornice profile_sweep 分层线脚 屋顶依附 parentRoof",
      "metadataFilter": {"doc_type": "component", "entity_type": "cornice"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["cornice", "profile_sweep", "parentRoof", "悬空檐口"]
    },
    {
      "id": "supported_chimney_boundary",
      "query": "烟囱 chimney wallThickness parentRoof 屋顶穿透边界",
      "metadataFilter": {"doc_type": "component", "entity_type": "chimney"},
      "expectedSources": ["composite-components-second-batch.md"],
      "requiredTerms": ["chimney", "wallThickness", "屋顶"]
    }
  ]
}
