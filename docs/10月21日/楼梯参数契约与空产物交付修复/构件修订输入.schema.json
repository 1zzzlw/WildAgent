{
  "$defs": {
    "ComponentConnection": {
      "additionalProperties": false,
      "description": "边界对齐；offset 为 own_face 坐标减 target_face 坐标。",
      "properties": {
        "target": {
          "minLength": 1,
          "type": "string"
        },
        "own_face": {
          "enum": [
            "left",
            "right",
            "bottom",
            "top",
            "front",
            "back"
          ],
          "type": "string"
        },
        "target_face": {
          "enum": [
            "left",
            "right",
            "bottom",
            "top",
            "front",
            "back"
          ],
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "target",
        "own_face",
        "target_face"
      ],
      "type": "object"
    },
    "ComponentInstance": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "properties": {
                  "plan_position": {
                    "type": "array"
                  }
                },
                "required": [
                  "plan_position"
                ],
                "type": "object"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "properties": {
              "form": {
                "additionalProperties": true,
                "description": "plan_position 对应的可计算设计输入；其余楼梯仍保留开放形态。",
                "properties": {
                  "shape": {
                    "const": "U",
                    "type": "string"
                  },
                  "flights": {
                    "const": 2,
                    "description": "U形双跑固定为2，可省略，由程序补齐",
                    "type": "integer"
                  },
                  "span_direction": {
                    "description": "第一跑上行的世界坐标方向",
                    "enum": [
                      "+x",
                      "-x",
                      "+z",
                      "-z"
                    ],
                    "type": "string"
                  },
                  "flight_width": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "单跑宽度（米）",
                    "gt": 0
                  },
                  "landing_depth": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "沿第一跑行进方向的平台深度（米）",
                    "gt": 0
                  },
                  "rises": {
                    "anyOf": [
                      {
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_riser_height": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "riser_height": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tread_depth": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "landing_thickness": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "shape",
                  "span_direction",
                  "flight_width",
                  "landing_depth"
                ],
                "type": "object"
              },
              "size": {
                "properties": {
                  "width": {
                    "description": "整组世界X方向占地（米）"
                  },
                  "depth": {
                    "description": "整组世界Z方向占地（米）"
                  }
                },
                "required": [
                  "width",
                  "depth"
                ]
              },
              "floor_connections": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "form",
              "size",
              "floor_connections"
            ]
          }
        }
      ],
      "description": "保留实例设计及扩展参数，由 plan 实现形态与依附关系。",
      "properties": {
        "type": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportRelation"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor_connections": {
          "items": {
            "$ref": "#/$defs/FloorConnection"
          },
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/ComponentConnection"
          },
          "type": "array"
        },
        "repetition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRepetition"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "宿主引用 ID；省略、空字符串或 null 表示无宿主"
        },
        "description": {
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentPlacement"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "form": {
          "additionalProperties": true,
          "type": "object"
        },
        "material_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_bindings": {
          "additionalProperties": false,
          "patternProperties": {
            "^(?:material|.*Material)$": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "ComponentPlacement": {
      "additionalProperties": true,
      "properties": {
        "face": {
          "anyOf": [
            {
              "enum": [
                "front",
                "back",
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "number"
        },
        "sill_height": {
          "type": "number"
        },
        "normal_offset": {
          "description": "沿宿主墙局部法线的偏移；不是世界 X/Z",
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_position": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "单连接U形双跑楼梯整组平面中心 [X,Z]；竖向位置由 floor_connections 计算"
        }
      },
      "type": "object"
    },
    "ComponentRepetition": {
      "additionalProperties": false,
      "description": "等距直线排列的矩形零件；spacing 为相邻中心距，position 为整组中心。",
      "properties": {
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "type": "string"
        },
        "spacing": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0
        },
        "member_size": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "gt": 0
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "count",
        "axis",
        "spacing",
        "member_size"
      ],
      "type": "object"
    },
    "FloorConnection": {
      "additionalProperties": false,
      "properties": {
        "from_floor": {
          "minimum": 1,
          "type": "integer"
        },
        "to_floor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "const": "roof",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "from_floor",
        "to_floor"
      ],
      "type": "object"
    },
    "SupportRelation": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "target": {
          "description": "关系目标的稳定实例 ID 或实体 ID",
          "minLength": 1,
          "type": "string"
        },
        "along_ratio": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "depth_ratio": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentInstance"
      },
      "type": "array"
    }
  },
  "required": [],
  "type": "object"
}
