{
  "$defs": {
    "ArchitectureIntent": {
      "additionalProperties": true,
      "description": "审核前的整体设计方向；不冒充已编译几何或专业规范结论。",
      "properties": {
        "goals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spatial_strategy": {
          "type": "string"
        },
        "composition": {
          "type": "string"
        },
        "material_strategy": {
          "type": "string"
        },
        "selected_systems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CirculationDecision": {
      "additionalProperties": true,
      "properties": {
        "vertical_strategy": {
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/CirculationPath"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CirculationPath": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "floor": {
          "minimum": 1,
          "type": "integer"
        },
        "points": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "type": "array"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0
        }
      },
      "required": [
        "id",
        "floor",
        "points",
        "width",
        "height"
      ],
      "type": "object"
    },
    "ComponentConnection": {
      "additionalProperties": false,
      "description": "边界对齐；offset 为 own_face 坐标减 target_face 坐标。",
      "properties": {
        "target": {
          "minLength": 1,
          "type": "string"
        },
        "own_face": {
          "enum": [
            "left",
            "right",
            "bottom",
            "top",
            "front",
            "back"
          ],
          "type": "string"
        },
        "target_face": {
          "enum": [
            "left",
            "right",
            "bottom",
            "top",
            "front",
            "back"
          ],
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "target",
        "own_face",
        "target_face"
      ],
      "type": "object"
    },
    "ComponentInstance": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "properties": {
                  "plan_position": {
                    "type": "array"
                  }
                },
                "required": [
                  "plan_position"
                ],
                "type": "object"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "properties": {
              "form": {
                "additionalProperties": true,
                "description": "plan_position 对应的可计算设计输入；其余楼梯仍保留开放形态。",
                "properties": {
                  "shape": {
                    "const": "U",
                    "type": "string"
                  },
                  "flights": {
                    "const": 2,
                    "description": "U形双跑固定为2，可省略，由程序补齐",
                    "type": "integer"
                  },
                  "span_direction": {
                    "description": "第一跑上行的世界坐标方向",
                    "enum": [
                      "+x",
                      "-x",
                      "+z",
                      "-z"
                    ],
                    "type": "string"
                  },
                  "flight_width": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "单跑宽度（米）",
                    "gt": 0
                  },
                  "landing_depth": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "沿第一跑行进方向的平台深度（米）",
                    "gt": 0
                  },
                  "rises": {
                    "anyOf": [
                      {
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_riser_height": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "riser_height": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tread_depth": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "landing_thickness": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "gt": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "shape",
                  "span_direction",
                  "flight_width",
                  "landing_depth"
                ],
                "type": "object"
              },
              "size": {
                "properties": {
                  "width": {
                    "description": "整组世界X方向占地（米）"
                  },
                  "depth": {
                    "description": "整组世界Z方向占地（米）"
                  }
                },
                "required": [
                  "width",
                  "depth"
                ]
              },
              "floor_connections": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "form",
              "size",
              "floor_connections"
            ]
          }
        }
      ],
      "description": "保留实例设计及扩展参数，由 plan 实现形态与依附关系。",
      "properties": {
        "type": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportRelation"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor_connections": {
          "items": {
            "$ref": "#/$defs/FloorConnection"
          },
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/ComponentConnection"
          },
          "type": "array"
        },
        "repetition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRepetition"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "宿主引用 ID；省略、空字符串或 null 表示无宿主"
        },
        "description": {
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentPlacement"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "form": {
          "additionalProperties": true,
          "type": "object"
        },
        "material_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_bindings": {
          "additionalProperties": false,
          "patternProperties": {
            "^(?:material|.*Material)$": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "ComponentPlacement": {
      "additionalProperties": true,
