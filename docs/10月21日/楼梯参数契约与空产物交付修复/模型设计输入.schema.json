        "normal_offset": {
          "description": "沿宿主墙局部法线的偏移；不是世界 X/Z",
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
