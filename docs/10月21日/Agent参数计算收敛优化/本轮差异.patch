+def architecture_input_schema() -> dict:
+    """从保存契约投影模型输入协议，移除程序状态和派生清单。"""
+    import re
+    schema = ArchitectureDecisions.model_json_schema()
+    roots = {"concept", "design_intent", "massing", "volumes", "structural_grid", "construction",
+             "circulation", "facades", "roof", "components", "floor_layouts", "envelope", "materials"}
+    schema["properties"] = {k:v for k,v in schema["properties"].items() if k in roots}
+    schema["required"] = [k for k in schema.get("required", []) if k in roots]
+    definitions = schema.get("$defs", {})
+    for name, optional in (("MassingDecision", {"width", "depth", "modeled_floors"}), ("FacadeDecision", {"bays"})):
+        node = definitions[name]
+        node["required"] = [k for k in node.get("required", []) if k not in optional]
+    materials = definitions["MaterialIntent"]
+    materials["properties"] = {k:v for k,v in materials["properties"].items() if k in {"keywords", "regions", "definitions"}}
+    # 仅保留可达定义，避免把材质解析结果等程序状态注入设计提示。
+    needed = set(re.findall(r'#/\$defs/([^"/]+)', json.dumps(schema["properties"])))
+    pending = list(needed)
+    while pending:
+        name = pending.pop()
+        for target in re.findall(r'#/\$defs/([^"/]+)', json.dumps(definitions[name])):
+            if target not in needed:
+                needed.add(target)
+                pending.append(target)
+    schema["$defs"] = {k:v for k,v in definitions.items() if k in needed}
+    def compact(value):
+        if isinstance(value, list):
+            return [compact(v) for v in value]
+        if not isinstance(value, dict):
+            return value
+        # 注释、默认值由保存契约保留；模型输入只需类型、字段、引用和数值边界。
+        return {k:compact(v) for k,v in value.items() if k not in {"title", "description", "default", "examples"}}
+    return compact(schema)
