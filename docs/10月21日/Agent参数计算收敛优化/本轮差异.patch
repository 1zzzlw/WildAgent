+def complete_design_parameters(raw: dict) -> dict:
+    """只补充缺省且可唯一计算的字段；显式尺寸仍是约束，绝不覆盖。"""
+    from .contracts import VolumeDecision
+    from pydantic import ValidationError
+    result = deepcopy(raw)
+    volumes = result.get("volumes")
+    massing = result.get("massing")
+    if isinstance(volumes, list) and volumes and isinstance(massing, dict):
+        try:
+            values = [VolumeDecision.model_validate(v) for v in volumes]
+        except ValidationError:
+            values = []  # 无有效计算输入时留给完整契约报告原字段错误。
+        if values:
+            for axis, extent in (("x", "width"), ("z", "depth")):
+                massing.setdefault(extent, max(getattr(v, axis)+getattr(v, extent) for v in values)
+                                   - min(getattr(v, axis) for v in values))
+        if "floors" in massing:
+            massing.setdefault("modeled_floors", massing["floors"])
+            massing.setdefault("representation_mode", "full" if massing["modeled_floors"] == massing["floors"] else "schematic")
+    facades = [result.get("facades")]
+    facades.extend(v.get("facades") for v in (volumes if isinstance(volumes, list) else []) if isinstance(v, dict))
+    for group in facades:
+        for facade in group.values() if isinstance(group, dict) else []:
+            if not isinstance(facade, dict):
+                continue
+            a, b = facade.get("ground_pattern"), facade.get("upper_pattern")
+            if isinstance(a, list) and isinstance(b, list) and len(a) == len(b) and a:
+                facade.setdefault("bays", len(a))
+    return result
 
 
