+"""将参数齐全的设计直接落实为 WILD；未覆盖的形态返回 None，沿用模型通道。"""
+from copy import deepcopy
+
+from .coordinates import repetition_geometry
+
+
+def realize_marker(marker, context):
+    from app.agent.generation.capability import capability_surface
+    from app.agent.knowledge.component_names import resolve_component_name
+
+    design = marker["design"]
+    form = design.get("form") or {}
+    if not isinstance(form, dict) or design.get("relation"):
+        return None
