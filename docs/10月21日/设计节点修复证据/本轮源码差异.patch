+from app.design.coordinates import DesignCoordinateConflict, resolve_stair_geometry
+from app.utils.json_extractor import extract_json_object
+
+
+def response(content):
+    return SimpleNamespace(content=content, token_usage=None, call_id="fixture", finish_reason="stop")
+
+
+class DesignFeedback(unittest.TestCase):
+    def test_malformed_outer_object_cannot_become_a_nested_design(self):
+        malformed='{"massing":{"floors":2},"placement":{"position":[0,4.2+1.2,0]}}'
+        with self.assertRaisesRegex(ValueError, "JSON 格式错误.*4.2"):
+            extract_json_object(malformed, required_key="massing", outer_only=True, raise_on_error=True)
+        with self.assertRaisesRegex(ValueError, "JSON 格式错误"):
+            extract_json_object('{"operations":[{"value":{"x":1}},]}', required_key="operations",
+                                outer_only=True, raise_on_error=True)
+
+    def test_all_conflict_paths_survive_long_feedback(self):
+        message="/floor_layouts/0/rooms/0：" + "坐标说明"*100 + "；/floor_layouts/1/rooms/3：另一处墙房冲突"
+        reason=_validation_reason(ValueError(message))
+        self.assertIn("/floor_layouts/1/rooms/3", reason)
+        self.assertEqual(["/floor_layouts/0", "/floor_layouts/1"],
+                         _repair_paths(reason, {}, {"floor_layouts"}))
+
+    def test_stair_error_identifies_position_vector(self):
+        marker={"id":"stair", "design_path":"/decisions/components/3",
+                "floor_connections":[{"from_y":0,"to_y":3.4,"to_floor":2}],
+                "design":{"placement":{"position":[5,2,5]},"size":{"width":4.1,"depth":2.6},
+                          "form":{"shape":"U","flights":2,"span_direction":"+x",
+                                  "flight_width":1.2,"landing_depth":1.2}}}
+        with self.assertRaises(ValueError) as captured:
+            resolve_stair_geometry(marker)
+        reason=str(captured.exception)
+        self.assertIn("/components/3/placement/position", reason)
+        self.assertIn("position[1]", reason)
+        self.assertEqual(["/components/3"], _repair_paths(reason, {}, {"components"}))
+
+    def test_host_feedback_exposes_effective_walls_and_enclosure_repair(self):
+        exc=DesignCoordinateConflict([{"path":"/decisions/components/0/host", "reason":"宿主不存在"}],
+            context={"host_rule":"open=true 无墙；需要封闭时修订 /facades 或 /volumes",
+                     "wall_hosts":[{"id":"wall_main_front_L1","open":True}]})
+        reason=_validation_reason(exc)
+        self.assertIn("wall_main_front_L1",reason)
+        self.assertIn('"open": true',reason)
+        paths=_repair_paths(reason,{"facades":{},"volumes":[]},{"components","facades","volumes"})
+        self.assertTrue({"/components/0","/facades","/volumes"} <= set(paths))
+
