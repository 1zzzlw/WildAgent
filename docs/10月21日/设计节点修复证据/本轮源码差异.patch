+        self.assertEqual([True,False,False],[call.kwargs["enable_thinking"] for call in create.call_args_list])
+
+    async def test_unlocated_new_error_does_not_reuse_old_scope(self):
+        design={"massing":{"floors":2},"volumes":[],"components":[{"id":"part"}]}
+        replies=[response(json.dumps(design)),response('{"operations":[{"op":"add","path":"/components/0/description","value":"修订"}]}')]
+        checked=0
