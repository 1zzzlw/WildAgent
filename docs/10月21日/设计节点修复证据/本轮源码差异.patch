+"""体量起点坐标与总体尺寸控制；不把世界原点当场地边界。"""
+import json
+from math import hypot, isfinite
+
+
+class DesignCoordinateConflict(ValueError):
+    def __init__(self, conflicts: list[dict], *, context: dict | None = None):
+        self.conflicts = conflicts
+        self.context = context or {}
+        super().__init__(json.dumps({"code": "design_coordinate_conflict", "conflicts": conflicts,
+                                    **({"context": self.context} if self.context else {})}, ensure_ascii=False))
+
+
+def volume_conflicts(volumes: list[dict], massing: dict) -> list[dict]:
+    """massing 宽深是总体包络控制上限；差值比较对整体平移不变。"""
+    if not volumes:
+        return []
+    conflicts = []
+    for axis, extent in (("x", "width"), ("z", "depth")):
+        low = min(v[axis] for v in volumes)
+        high = max(v[axis] + v[extent] for v in volumes)
+        if high - low > massing[extent] + 0.001:
+            conflicts.append({"path": "/decisions/volumes", "value": volumes,
+                "conflict_path": "/decisions/massing/" + extent,
+                "conflict_value": massing[extent], "actual_extent": high - low,
+                "reason": "体量并集包围盒超出总体尺寸控制；必须显式修订，不能裁剪体量"})
+    for index, v in enumerate(volumes):
+        if v["end_floor"] > massing["modeled_floors"]:
+            conflicts.append({"path": f"/decisions/volumes/{index}/end_floor", "value": v["end_floor"],
+                "conflict_path": "/decisions/massing/modeled_floors",
+                "conflict_value": massing["modeled_floors"], "reason": "体量楼层超出建模层数"})
+    return conflicts
+
+
+
+def representative_floor_indices(massing):
+    count, floors = massing.modeled_floors, massing.floors
+    if massing.representation_mode == "schematic" and count > 1:
+        return [1 + round(i*(floors-1)/(count-1)) for i in range(count)]
+    return list(range(1, count+1))
+
+
+def floor_elevations(design):
+    """同一图纸的楼面世界标高；显式 level 优先，未声明时沿用层高。"""
+    height, count = design["massing"]["floor_height"], design["massing"]["floors"]
+    explicit = {}
+    layouts = design.get("floor_layouts") or []
+    if not isinstance(layouts, list):
+        raise ValueError("/floor_layouts：逐层布局必须是对象数组")
+    for index, layout in enumerate(layouts):
+        if not isinstance(layout, dict):
+            raise ValueError(f"/floor_layouts/{index}：每层布局必须是对象")
+        for key in ("rooms", "walls"):
+            if not isinstance(layout.get(key, []), list) or any(not isinstance(item, dict) for item in layout.get(key, [])):
+                raise ValueError(f"/floor_layouts/{index}/{key}：必须是对象数组")
+        if "floor" not in layout or layout.get("level") is None:
+            continue
+        floor, level = layout["floor"], layout["level"]
+        if isinstance(floor, bool) or not isinstance(floor, int) or not 1 <= floor <= count:
+            raise ValueError(f"/floor_layouts/{index}/floor：楼层必须是 1～{count} 的整数")
+        if isinstance(level, bool) or not isinstance(level, (int, float)) or not isfinite(level):
+            raise ValueError(f"/floor_layouts/{index}/level：楼面世界标高必须是有限数字")
+        if floor in explicit and explicit[floor] != level:
+            raise ValueError(f"/floor_layouts/{index}/level：同一楼层声明了不同标高")
+        explicit[floor] = level
+    base = explicit.get(1, 0)
+    levels = {i: explicit.get(i, base+(i-1)*height) for i in range(1, count+1)}
+    levels[count+1] = levels[count]+height
+    if any(levels[i+1] <= levels[i] for i in range(1, count)):
+        raise ValueError("/floor_layouts：上层楼面标高必须高于下层；显式修订，不能覆盖已声明标高")
+    return levels
+
+
+def floor_connection_targets(design, component):
+    """明确楼层引用的唯一标高来源；未声明连接时不猜测。"""
+    levels = floor_elevations(design)
+    count = design["massing"]["floors"]
+    targets, issues = [], []
+    for index, connection in enumerate(component.get("floor_connections") or []):
+        lower, upper = connection["from_floor"], connection["to_floor"]
+        destination = count + 1 if upper == "roof" else upper
+        if lower > count or destination > count + (upper == "roof") or destination <= lower:
+            issues.append({"code": "floor_connection_reference", "path": f"/floor_connections/{index}",
+                           "expected": f"1～{count} 层的递增连接或显式 roof", "actual": connection,
+                           "reason": "连接楼层不存在或上层不高于下层"})
+            continue
+        targets.append({**connection, "from_y": levels[lower], "to_y": levels[destination],
+                        "rise": levels[destination] - levels[lower]})
+    return targets, issues
+
+
+def room_rectangle(room):
+    """同一处解释新旧房间边界；返回世界 X/Z 的 min/max。"""
+    b = room["bounds"]
+    if "x" in b:
+        return [b["x"], b["z"], b["x"] + b["width"], b["z"] + b["depth"]]
+    return [b["x_start"], b["z_start"], b["x_end"], b["z_end"]]
+
+
+def construction_dimensions(design):
+    return {"slab_thickness": 0.2, "wall_thickness": 0.24, **(design.get("construction") or {})}
+
+
+def repetition_geometry(component):
+    repeat = component.get("repetition")
+    if not repeat:
+        return None
+    center = (component.get("placement") or {}).get("position")
+    if not center:
+        raise ValueError(f"/components/{component.get('id')}/placement/position：重复构件需要整组世界中心")
+    axis = "xyz".index(repeat["axis"])
+    extent = list(repeat["member_size"])
+    extent[axis] += (repeat["count"]-1)*repeat["spacing"]
+    for i, field in enumerate(("width", "height", "depth")):
+        value = (component.get("size") or {}).get(field)
+        if value is not None and abs(value-extent[i]) > 0.001:
+            raise ValueError(f"/components/{component.get('id')}/size/{field}：重复组实际包络为 {extent[i]:g}，设计为 {value:g}")
+    positions = []
+    for i in range(repeat["count"]):
+        p = list(center)
+        p[axis] += (i-(repeat["count"]-1)/2)*repeat["spacing"]
+        positions.append(p)
+    return {"positions": positions, "member_size": repeat["member_size"], "extent": extent}
+
+
+def subtract_rectangles(rectangles, cuts):
+    """矩形差集，保持庭院、挑空和梯井；仅处理世界 X/Z。"""
+    result = list(rectangles)
+    for cx0, cz0, cx1, cz1 in cuts:
+        remaining = []
+        for x0, z0, x1, z1 in result:
+            a, b, c, d = max(x0, cx0), max(z0, cz0), min(x1, cx1), min(z1, cz1)
+            if c <= a or d <= b:
+                remaining.append([x0, z0, x1, z1])
+            else:
+                remaining.extend(r for r in ([x0,z0,a,z1], [c,z0,x1,z1], [a,z0,c,b], [a,d,c,z1])
+                                 if r[2]-r[0] > 0.001 and r[3]-r[1] > 0.001)
+        result = remaining
+    return result
+
+
+def design_geometry_context(design):
+    """由同一图纸推导标高和空间边界，供构件实现与设计落实检查共用。"""
+    from .contracts import MassingDecision
+    from app.agent.knowledge.component_names import resolve_component_name
+
+    indices = representative_floor_indices(MassingDecision.model_validate(design["massing"]))
+    elevations = floor_elevations(design)
+    construction = construction_dimensions(design)
+    if any(construction["slab_thickness"] >= elevations[i+1]-elevations[i] for i in range(1, design["massing"]["floors"]+1)):
+        raise ValueError("/construction/slab_thickness：板厚必须小于对应层间高差")
+    volumes = {
+        v["id"]: {
+            "bounds": [v["x"], v["z"], v["x"] + v["width"], v["z"] + v["depth"]],
+            "center_xz": [v["x"] + v["width"] / 2, v["z"] + v["depth"] / 2],
+            "base_y": elevations[indices[v["start_floor"] - 1]],
+            "roof_support_y": elevations[indices[v["end_floor"] - 1] + 1],
+        }
+        for v in design.get("volumes") or []
+    }
+    levels = [
+        {"index": index, "base_y": elevations[index], "top_y": elevations[index + 1],
+         "height": elevations[index + 1] - elevations[index],
+         "slab_bottom_y": elevations[index] - construction["slab_thickness"],
+         "volume_ids": [v["id"] for v in design.get("volumes") or []
+                        if v["start_floor"] <= slot <= v["end_floor"]], "voids": []}
+        for slot, index in enumerate(indices, 1)
+    ]
+    by_floor = {level["index"]: level for level in levels}
+    stair_routes = {}
+    # 主体任务不再持有 components；委派的楼梯仍决定主体必须保留的梯井。
+    components = design.get("components") or design.get("delegated_components") or []
+    for component_index, component in enumerate(components):
+        if resolve_component_name(component.get("type", ""))["entity_type"] != "stair":
+            continue
+        targets, _ = floor_connection_targets(design, component)
+        marker = {"id": component.get("id", "stair"), "design": component, "floor_connections": targets,
+                  "design_path": f"/{'components' if 'components' in design else 'delegated_components'}/{component_index}"}
+        route = resolve_stair_geometry(marker)
+        if route:
+            stair_routes[marker["id"]] = route
+            void = route["void"]
+            if void["floor"] in by_floor:
+                by_floor[void["floor"]]["voids"].append({"bounds": void["bounds"], "derived": True,
+                    "design_path": f"/components/{marker['id']}/floor_connections"})
+    for layout_index, layout in enumerate(design.get("floor_layouts") or []):
+        for room_index, room in enumerate(layout.get("rooms") or []):
+            path = f"/floor_layouts/{layout_index}/rooms/{room_index}"
+            if "void" in room and type(room["void"]) is not bool:
+                raise ValueError(f"{path}/void：必须是 boolean，true 表示此层挑空")
+            if room.get("void") is not True:
+                continue
+            bounds = room_rectangle(room)
+            floor = layout.get("floor")
+            if type(floor) is not int or floor not in elevations or floor > design["massing"]["floors"]:
+                raise ValueError(f"{path}：挑空必须引用有效楼层 floor")
+            if floor in by_floor:
+                by_floor[floor]["voids"].append({
+                    "design_path": path,
+                    "bounds": bounds,
+                })
+    paths = [{**path, "base_y": elevations[path["floor"]],
+              "top_y": elevations[path["floor"]] + path["height"]}
+             for path in (design.get("circulation") or {}).get("paths", [])]
+    rooms = [{**room, "floor": layout["floor"], "rect": room_rectangle(room)}
+             for layout in design.get("floor_layouts") or [] for room in layout.get("rooms") or []]
+    for level in levels:
+        regions = []
+        for vid in level["volume_ids"]:
+            regions.extend(subtract_rectangles([volumes[vid]["bounds"]], regions))
+        level["floor_rectangles"] = subtract_rectangles(
+            regions,
+            [void["bounds"] for void in level["voids"]])
+    repetitions = {c["id"]: repetition_geometry(c) for c in components if c.get("repetition")}
+    return {"levels": levels, "volumes": volumes, "construction": construction,
