+                                type(bounds.get(k)) in (int, float) and isfinite(bounds[k])
+                                for k in ("x", "z", "width", "depth")):
+                            continue
+                        left, right = max(x0, bounds["x"]), min(x1, bounds["x"]+bounds["width"])
+                        front, back = max(z0, bounds["z"]), min(z1, bounds["z"]+bounds["depth"])
