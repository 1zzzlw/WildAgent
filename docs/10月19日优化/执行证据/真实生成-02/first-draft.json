{
  "concept": "现代L形庭院别墅：后侧两层主楼与左侧单层侧翼围合前庭，通高客厅面向庭院，双跑楼梯居中偏后连接二层卧室区，侧翼屋顶为可达露台配轻钢结构廊架与栏杆。",
  "design_intent": {
    "goals": [
      "L形布局围合前院，主入口经庭院进入",
      "客厅通高两层，面向庭院大面积玻璃",
      "二层设两间卧室、一主卫一次卫",
      "侧翼屋顶为可达露台，配连接门、栏杆与廊架",
      "双跑楼梯带平台与楼板洞口",
      "室内家具陈设、照明与入口通路完整"
    ],
    "assumptions": [
      "主楼14m×8m两层，侧翼8m×8m一层，庭院约6m×8m",
      "层高统一3.5m，通高客厅占满两层共7.0m",
      "侧翼屋顶标高3.5m，作为露台使用",
      "双跑楼梯宽3.0m，平台深1.5m，梯跑长3.0m",
      "前院从南侧进入，主入口位于主楼南立面"
    ],
    "selected_systems": [
      "钢筋混凝土框架结构",
      "浅灰抹灰外墙+深灰金属板点缀",
      "物理玻璃落地窗系统",
      "侧翼露台钢构廊架"
    ],
    "spatial_strategy": "主楼沿Z轴后侧布置，侧翼沿X轴左前侧延伸形成L形围合；庭院朝向正面（最小Z面）开放，主入口从庭院进入主楼通高客厅；餐厨居右侧，楼梯居中连接上下；二层卧室沿东侧布置。",
    "composition": "两层主楼与单层侧翼形成高差体量组合，通高玻璃面与实墙面交替，露台水平延展与主楼垂直体量对比。",
    "material_strategy": "主体外墙浅灰抹灰(facade_primary)；窗框深灰阳极氧化铝(frame)；门扇及露台廊架深色金属(dark metal)；侧翼露台地面浅灰石材(ground)；室内地板橡木色(floor)；家具布艺与木色；玻璃采用物理透明玻璃。"
  },
