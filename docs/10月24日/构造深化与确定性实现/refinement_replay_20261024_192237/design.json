    "design_intent": {
      "goals": [
        "在14x12米范围内构建L形体量",
        "实现面向内院的采光与景观视野",
        "通过木格栅重复构件体现构造细节"
      ],
      "assumptions": [
        "单层建筑，层高3.5米",
        "主入口位于两翼交接处的转角区域或长翼端头",
        "庭院地面为硬化铺装或保留空地，不种植复杂植被"
      ],
      "spatial_strategy": "L形布局将私密卧室置于短翼，公共客厅置于长翼并面向庭院开放，入口作为过渡空间连接内外。",
      "composition": "不对称的L形构图，长翼主导水平延展，短翼提供垂直封闭感，庭院为视觉中心。",
      "material_strategy": "墙体采用浅米色抹灰，屋面及檐口为深炭灰色，窗框及格栅为暖木色，形成明暗与冷暖对比。",
      "selected_systems": [
        "混凝土框架/砌体结构（简化表达）",
        "双坡屋顶（深灰色金属瓦）",
        "外置木格栅遮阳系统"
      ]
    },
