index b181da6..74d7a5d 100644
--- a/wild-server/app/agent/generation/spatial/geometry.py
+++ b/wild-server/app/agent/generation/spatial/geometry.py
@@ -17,6 +17,24 @@ Point = tuple[float, float]
 CONSTRUCTION_GRID = 0.1
 
 
+def subtract_rectangles(bounds, cuts, *, epsilon=0.001):
+    """矩形差集，返回互不重叠的 X/Z 矩形；供挑空和楼梯开口共用。"""
+    rectangles = [tuple(bounds)]
+    for cx0, cz0, cx1, cz1 in cuts:
+        remaining = []
+        for x0, z0, x1, z1 in rectangles:
+            a, b, c, d = max(x0, cx0), max(z0, cz0), min(x1, cx1), min(z1, cz1)
+            if c-a <= epsilon or d-b <= epsilon:
+                remaining.append((x0, z0, x1, z1))
+                continue
+            remaining.extend(r for r in (
+                (x0, z0, a, z1), (c, z0, x1, z1),
+                (a, z0, c, b), (a, d, c, z1),
+            ) if r[2]-r[0] > epsilon and r[3]-r[1] > epsilon)
+        rectangles = remaining
+    return rectangles
+
+
 def snap_to_grid(value: float, step: float = CONSTRUCTION_GRID) -> float:
     """把数值吸附到构造网格（round 到 step 的整数倍）。"""
     return round(round(float(value) / step) * step, 6)
