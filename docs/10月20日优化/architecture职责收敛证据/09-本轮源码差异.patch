+def resolve_stair_steps(design, component, path):
+    """统一推导已选等高分跑；只补充标记，不修改设计决定或猜测楼层连接。"""
+    from copy import deepcopy
+    from math import ceil, isclose
+
+    basis = component.get("step_design")
+    if basis is None:
+        return component
+    targets, issues = floor_connection_targets(design, component)
+    if issues or len(targets) != 1:
+        raise ValueError(f"{path}/floor_connections：等高踏步推导需要一条有效的起终楼面连接")
+    flights, rise = basis["flights"], targets[0]["rise"]
+    count = basis.get("steps_per_flight") or ceil(rise/(flights*basis["max_riser_height"]))
+    values = {"flights": flights, "rises": count, "riser_height": rise/(flights*count)}
+    result = deepcopy(component)
+    for target, expected, root in ((result.setdefault("size", {}), {"height": rise}, "size"),
+                                   (result.setdefault("form", {}), values, "form")):
+        for key, value in expected.items():
+            if key in target and (type(target[key]) not in (int, float)
+                                  or not isclose(target[key], value, rel_tol=1e-9, abs_tol=1e-9)):
+                raise ValueError(f"{path}/{root}/{key}：已填 {target[key]!r} 与楼面及 step_design 推导值 {value:g} 冲突；"
+                                 "保留用户明确要求；只选择一个踏步设计依据，不重复填写计算结果")
+            target[key] = value
+    placement = result.get("placement") or {}
+    center = placement.get("center_xz")
+    if center is not None:
+        position = [center[0], (targets[0]["from_y"]+targets[0]["to_y"])/2, center[1]]
+        if "position" in placement and placement["position"] != position:
+            raise ValueError(f"{path}/placement/position：与 center_xz 和楼面连接推导的中心 {position} 冲突")
+        result["placement"] = {**placement, "position": position}
+    return result
 
 
