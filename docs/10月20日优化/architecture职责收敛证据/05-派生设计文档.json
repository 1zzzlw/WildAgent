    "design_intent": {
      "goals": [
        "创造与自然环境和谐融合的居住空间",
        "提供开放通透的公共区域与私密的私人区域",
        "通过简洁材质表达现代别墅的优雅与实用"
      ],
      "assumptions": [
        "场地平坦，无特殊地形限制",
        "气候温和，适合大面积玻璃设计",
        "业主偏好现代简约风格，注重室内外空间流动"
      ],
      "spatial_strategy": "L形平面布局，主楼与侧翼围合中央庭院。公共区域（客厅、餐厅、厨房）位于主楼，私密区域（卧室）位于侧翼。通高客厅连接庭院，创造视觉连续性。",
      "composition": "简洁几何形态，水平线条主导。主楼与侧翼形成虚实对比，混凝土体块与通透玻璃幕墙交替出现。平屋顶轻微坡度确保排水，檐口简洁处理。",
      "material_strategy": "主材为混凝土、木材和玻璃。混凝土用于结构体块和基座，木材用于装饰性框架和部分立面，大面积玻璃创造通透感。材质对比明确，避免过度装饰。",
      "selected_systems": [
        "钢结构框架体系",
        "平屋顶排水系统",
        "大面积玻璃幕墙系统"
      ]
    }
