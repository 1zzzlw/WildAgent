+def _uncertain_intersects(entity, paths, bottom, top):
+    """仅用已知原语的保守球包络排除远处对象，不能推导包络时继续待复核。"""
+    if entity.get('type') != 'primitive' or not _vector(entity.get('position'), 3):
+        return True
+    shape = entity.get('shape')
+    scale = entity.get('scale', [1, 1, 1])
+    if not _vector(scale, 3):
+        return True
+    if shape == 'sphere':
+        radius = entity.get('radius')
+    elif shape == 'cylinder':
+        radii = [entity.get('radius')] if 'radius' in entity else [entity.get('radiusTop'), entity.get('radiusBottom')]
+        height = entity.get('height')
+        if (not all(type(r) in (int, float) and isfinite(r) and r >= 0 for r in radii)
+                or type(height) not in (int, float) or not isfinite(height) or height <= 0):
+            return True
+        radius = hypot(max(radii), height/2)
+    else:
+        return True
+    if type(radius) not in (int, float) or not isfinite(radius) or radius <= 0:
+        return True
+    radius *= max(abs(v) for v in scale)
+    x, y, z = entity['position']
+    if min(y+radius, top)-max(y-radius, bottom) <= EPS:
+        return False
+    bounds = [[x-radius,z-radius], [x+radius,z-radius], [x+radius,z+radius], [x-radius,z+radius]]
+    return any(_overlap(route, bounds) for route in paths)
+
