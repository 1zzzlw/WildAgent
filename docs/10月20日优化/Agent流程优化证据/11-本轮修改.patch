+    elif kind == 'floor' and position and form.get('shape', 'rect') == 'rect':
+        thickness = size.get('height', form.get('thickness'))
+        if not all(type(v) in (int, float) and v > 0 for v in (size.get('width'), size.get('depth'), thickness)):
+            return None
+        x, y, z = position
+        parameters.update({'from': [x-size['width']/2, y-thickness/2, z-size['depth']/2],
+                           'to': [x+size['width']/2, y-thickness/2, z+size['depth']/2], 'thickness': thickness})
+    elif kind == 'primitive' and entity.get('shape') == 'box' and position:
+        if not all(k in size for k in ('width', 'height', 'depth')) and 'dimensions' not in entity:
+            return None
+        parameters['position'] = list(position)
+        if size:
+            if set(size) != {'width', 'height', 'depth'}:
+                return None
+            parameters['dimensions'] = [size[k] for k in ('width', 'height', 'depth')]
+    elif size:
+        return None  # 未声明尺寸到该原生形态的映射，不能静默忽略图纸尺寸。
+    elif position and 'position' in properties:
+        parameters['position'] = list(position)
