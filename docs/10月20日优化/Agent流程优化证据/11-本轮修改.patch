+            return None
+        wall = opening_host(blueprint, marker)
+        if not wall or wall.get('curve') or any(k in form for k in ('parentWall', 'from')):
+            return None
+        if any(k in form and form[k] != size[k] for k in ('width', 'height')):
+            raise ValueError('图纸 size 与原生 form 的门窗尺寸冲突，需显式修订图纸')
+        diagram = marker.get('diagram_host') or wall
+        target = opening_target(marker, diagram, size['width'], size['height'])
+        if target is None:
+            return None
+        parameters.update(parentWall=diagram['id'], **{'from': target}, width=size['width'], height=size['height'])
+        if 'depth' in size:
+            parameters['frameDepth'] = size['depth']
+        bindings = {'frameMaterial': 'frame', 'glassMaterial' if kind == 'window' else 'leafMaterial':
+                    'glass' if kind == 'window' else 'door'}
+        for field, role in bindings.items():
+            if field not in entity:
+                if material_roles.get(role) not in blueprint['materials']:
+                    return None
