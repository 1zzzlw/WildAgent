+        return None
+    form = design.get('form') or {}
+    properties = definition.get('properties', {})
+    if not isinstance(form, dict) or set(form) - properties.keys():
+        return None  # 开放的设计描述不能静默丢掉，尤其不能把自定义构造降为默认形态。
+    entity = deepcopy(form)
